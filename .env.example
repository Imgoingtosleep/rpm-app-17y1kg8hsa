# RPM App Configurations (.env.example)

# 1. Database Settings
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=rpm_db
DB_PORT_EXTERNAL=5434

# 2. Backend API & Storage Settings
BACKEND_PORT=1050
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@localhost:5434/rpm_db
# Path on host/server to store images (Default: ./storage or /mnt/nas/rpm_storage)
STORAGE_PATH=./storage

# 3. Security & JWT Secrets (CRITICAL: Change in production!)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_chars
SHARED_JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_chars
NEXTAUTH_SECRET=your_super_secret_nextauth_cookie_key_here
NEXTAUTH_URL=http://localhost:1000
AUTH_TRUST_HOST=true

# 4. Frontend Settings
FRONTEND_PORT=1000
VITE_API_URL=http://localhost:1050
NEXT_PUBLIC_API_URL=http://localhost:1050

# 5. OAuth Identity Providers (Google / Azure)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 6. pgAdmin Settings
PGADMIN_EMAIL=admin@rpm.com
PGADMIN_PASSWORD=your_secure_pgadmin_password
