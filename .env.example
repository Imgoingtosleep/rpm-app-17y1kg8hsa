# RPM App Configurations (.env.example)

# 1. Database Settings
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=rpm_db
DB_PORT_EXTERNAL=5434

# 2. Backend API Settings
BACKEND_PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5434/rpm_db

# 3. Frontend Settings
FRONTEND_PORT=1000
VITE_API_URL=http://localhost:5000

# 4. pgAdmin Settings
PGADMIN_EMAIL=admin@rpm.com
PGADMIN_PASSWORD=adminpassword

# Google OAuth
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Microsoft Azure AD (Entra ID)
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
