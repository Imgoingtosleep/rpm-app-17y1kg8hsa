# RPM App Configurations (.env) - Server Production Config

# 1. Database Settings (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=123
DB_NAME=rpm_db
DB_PORT_EXTERNAL=8432

# 2. Backend API Settings
BACKEND_PORT=8050
NODE_ENV=development
DATABASE_URL=postgresql://postgres:123@db:5432/rpm_db
STORAGE_PATH=./storage

# 3. Security & JWT Settings (CRITICAL: Shared Secret for Token Validation)
JWT_SECRET=netops-secure-token-signing-key-7892
SHARED_JWT_SECRET=netops-secure-token-signing-key-7892
NEXTAUTH_SECRET=rpm-secure-auth-secret-key-9988
AUTH_TRUST_HOST=true

# 4. Frontend & NextAuth Settings (Hub Server IP / Subpath on Port 8000)
FRONTEND_PORT=8001
NEXT_PUBLIC_BASE_PATH=/rpm/8000
BASE_PATH=/rpm/8000
NEXTAUTH_URL=http://10.1.10.124/rpm/8000
NEXT_PUBLIC_API_URL=http://10.1.10.124/rpm/8000
VITE_API_URL=http://10.1.10.124/rpm/8000

# 5. Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=1098192783957-79ecas4tjir7hunaco5etk1nujav3aro.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1098192783957-79ecas4tjir7hunaco5etk1nujav3aro.apps.googleusercontent.com

# 6. pgAdmin Management UI Settings (Port 8055)
PGADMIN_EMAIL=admin@rpm.com
PGADMIN_PASSWORD=adminpassword


# 7. Single View Authentication (Accounting Server)
SINGLE_VIEW_API_URL=http://10.1.10.200
SINGLE_VIEW_APP_NAME=Noc Tools
SINGLE_VIEW_TIMEOUT_MS=10000
SINGLE_VIEW_EMAIL_DOMAIN=rpm.com
