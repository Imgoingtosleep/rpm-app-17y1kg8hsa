# Reverse proxy สำหรับติดตั้งบน "เครื่องกลาง" (ไม่ใช่บน 10.1.10.124)
# เครื่องกลางต้อง: (1) user เข้าถึงพอร์ตที่ listen ได้  (2) ต่อ 10.1.10.124:80 ได้
# ทดสอบบนเครื่องกลางก่อน:  curl -I http://10.1.10.124
#
# ติดตั้ง (บนเครื่องกลาง):
#   sudo cp gateway-proxy.conf.example /etc/nginx/conf.d/rpm.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# หลังติดตั้ง ให้แก้ .env บน 10.1.10.124 ให้ URL ตรงกับที่ user เปิดจริง แล้ว rebuild frontend:
#   NEXTAUTH_URL / NEXT_PUBLIC_API_URL / VITE_API_URL = http://<ชื่อหรือIPเครื่องกลาง>[:พอร์ต]
#   docker compose up -d --build frontend

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    # ถ้าเครื่องกลางมีเว็บอื่นใช้พอร์ต 80 อยู่แล้ว ให้ใช้ server_name แยก (เช่น rpm.<domain>)
    # หรือเปลี่ยนเป็นพอร์ตอื่นที่ firewall เปิดไว้
    listen 80;
    server_name rpm.example.local;

    client_max_body_size 100M;

    location / {
        proxy_pass http://10.1.10.124:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
